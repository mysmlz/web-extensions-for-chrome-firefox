{
  "manifest_version": 3,
  "name": "BlingBling",
  "version": "0.1.2",
  "short_name": "bling",
  "description": "bilibili页面优化",
  "content_scripts": [
    {
      "js": [
        "scripts/content.js"
      ],
      "css": [
        "styles/index.css",
        "styles/swipe.css",
        "styles/upload-hide.css",
        "styles/vip-hide.css"
      ],
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "run_at": "document_start"
    }
  ]
}
