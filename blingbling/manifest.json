{
  "manifest_version": 3,
  "name": "BlingBling",
  "version": "0.2.7",
  "short_name": "bling",
  "description": "bilibili页面优化",
  "icons": {
    "16": "icons/Wink.png",
    "32": "icons/Wink.png",
    "64": "icons/Wink.png",
    "128": "icons/Wink.png"
  },
  "content_scripts": [
    {
      "js": [
        "scripts/browser-polyfill.min.js",
        "scripts/content.js"
      ],
      "css": [
        "styles/index.css",
        "styles/swipe.css",
        "styles/dark.css",
        "styles/hide.css"
      ],
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ]
}
